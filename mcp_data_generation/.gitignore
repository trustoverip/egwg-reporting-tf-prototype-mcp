# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# VS Code
.vscode/

# Node
node_modules/

# OS files
.DS_Store
Thumbs.db

# Data content. Zoom names chat exports "<stem>_RecordingnewChat.txt" with an
# underscore, and occasionally "<stem>.cutfile.<digits>newChat.txt", so the
# pattern has to end at "newChat.txt" rather than assume a leading dot.
data/raw/**/*.vtt
data/raw/**/*.md
data/raw/**/*newChat.txt
data/raw/**/fetch-manifest.tsv
data/processed/**/*.json
data/curated/**/*.json

# Ingestion registry
data/ingestion_registry.json

# Keep examples
!data/**/metadata.json
!data/**/.gitkeep

# Logs
*.log

